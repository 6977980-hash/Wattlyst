      "@type": "Question",
      "name": "How many watts does a ceiling fan use?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "A normal AC ceiling fan uses about 80 W; a DC inverter fan uses less than half of that. The cooling table below lists both."
      }
     },
     {
      "@type": "Question",
      "name": "Where do these wattage figures come from?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "From published appliance wattage tables, manufacturer datasheets and Pakistani retailer specifications, listed in the sources at the bottom of the page. Figures marked as Wattlyst estimates in the data file are awaiting engineer confirmation."
      }
     },
     {
      "@type": "Question",
      "name": "Why is the starting wattage higher than the running wattage?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Motors and compressors need extra current to get moving. The surge lasts a moment but an inverter, UPS or generator must be able to supply it, which is why sizing tools use the starting watts of the largest motor."
      }
     },
     {
      "@type": "Question",
      "name": "How do I turn watts into my monthly bill?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Multiply watts by hours a day, divide by one thousand for units a day, multiply by the days in the month and then by your tariff rate. The home load calculator and the bill calculator do this for you."
      }
     }
