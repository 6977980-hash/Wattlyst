    "mainEntity": [
     {
      "@type": "Question",
      "name": "How do I calculate the load of an appliance?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Read the running watts from the label, or take it from the list above. For amps, divide the watts by volts × power factor; for units a day, multiply the watts by the hours it runs and divide by one thousand. A 200 W fridge draws 1.1 A at 230 V and uses 1.6 units a day."
      }
     },
     {
      "@type": "Question",
      "name": "What is the difference between running watts and starting watts?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Running watts is the steady draw while the appliance works. Starting watts is the short surge when a motor or compressor starts, about three times higher: the fridge above runs at 200 W and starts at 1,200 W. Heaters and electronics have no surge."
      }
     },
     {
      "@type": "Question",
      "name": "How many units does a fridge use per month?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "A non-inverter fridge whose compressor runs about eight hours a day uses 1.6 units a day and 48 units a month, about Rs 1,750 at Rs 36.46 per unit. An inverter fridge uses less because it runs at lower power."
      }
     },
     {
      "@type": "Question",
      "name": "How much does it cost to run an AC per month?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "A 1.5 ton inverter AC for eight hours a day uses about 240 units a month, about Rs 8,750 at Rs 36.46 per unit, before fixed charges and taxes. Hot rooms, long hours and a low set point push it higher."
      }
     },
     {
      "@type": "Question",
      "name": "What is the energy consumption of a ceiling fan?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "About 80 W for a normal AC fan, so twelve hours a day is 0.96 units a day and 28.8 units a month, about Rs 1,050. A DC inverter fan uses less than half of that."
      }
     },
     {
      "@type": "Question",
      "name": "How do I find the watts of an appliance that only shows amps?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Multiply the amps by the supply volts (230 V in Pakistan) and, for motors, by the power factor of about 0.8. Then enter that figure as a Custom appliance above, or use the unit calculator in amps mode."
      }
     },
     {
      "@type": "Question",
      "name": "Can I add several appliances here instead of using the home load calculator?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Yes, for a few. The calculator adds the running watts, adds the surge of the largest motor once and totals the units. For a whole house, with the check against your sanctioned load, the home electrical load calculator is built for that."
      }
     }
