    "mainEntity": [
     {
      "@type": "Question",
      "name": "What are starting watts on a generator?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "On a generator, starting (surge or peak) watts are the extra power it can give for a few seconds to start a motor; running (rated) watts are what it can give continuously. Size the running rating to cover your appliances' starting watts and keep the surge figure as reserve."
      }
     },
     {
      "@type": "Question",
      "name": "Are rated watts the same as running watts?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Yes. Rated, running and continuous watts all mean the steady power. Surge, peak and starting watts all mean the short burst at start."
      }
     },
     {
      "@type": "Question",
      "name": "Why do starting watts matter?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Because a generator or inverter that cannot supply them cannot start the appliance. A 1 ton non-inverter AC runs at 1,200 W but needs a 5 kVA generator because it starts at 3,600 W."
      }
     },
     {
      "@type": "Question",
      "name": "What is the difference between continuous and peak watts?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Continuous watts can be drawn for hours; peak watts only for seconds. A fridge is continuous at 200 W and peaks at 1,200 W each time its compressor starts."
      }
     },
     {
      "@type": "Question",
      "name": "Do starting watts increase my electricity bill?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Barely. The surge lasts a second or two, so it adds a tiny amount of energy. Your units depend on running watts and hours; use the appliance load calculator for those."
      }
     },
     {
      "@type": "Question",
      "name": "How do I find the starting watts of my appliance?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Look for locked-rotor amps (LRA) on the nameplate of a motor or compressor and multiply by the voltage: that is the starting VA, not watts. Choose Custom in the calculator, enter the running watts, and in Starting watts enter LRA × voltage × 0.8, the generator power factor, so the generator kVA covers the starting VA. If none is printed, pick the appliance in the calculator above; our data uses a multiple of the running watts for motors and compressors."
      }
     }
    ]
