   {
    "@type": "FAQPage",
    "@id": "https://wattlyst.com/load/home-electrical-load-calculator/#faq",
    "mainEntity": [
     {
      "@type": "Question",
      "name": "How do I calculate the electrical load of my house?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "List every appliance that can run at the same time, take the running watts from its label or the appliance list, multiply by how many you have and add them up. Divide the total by volts × power factor (230 V × 0.8 in Pakistan) for amps."
      }
     },
     {
      "@type": "Question",
      "name": "What is the total load of a house in kW?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Most Pakistani homes without an AC run at well under one kilowatt; a home with one inverter AC, fans, lights and a fridge runs at about 3.1 kW, and each extra inverter AC adds about 1 kW on average and more at full speed."
      }
     },
     {
      "@type": "Question",
      "name": "What is a connected load and how is it different from running load?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Connected load is the sum of everything wired in the house; running load is what is on at the same moment. Bills and sanctioned loads are set against expected demand, so the running load is the number to plan with."
      }
     },
     {
      "@type": "Question",
      "name": "How many units does this load use per month?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Each appliance's watts × hours a day ÷ 1,000 gives its units a day; add them and multiply by 30. The default home above uses about 15.1 units a day and 454 a month."
      }
     },
     {
      "@type": "Question",
      "name": "Can I use this load to size a UPS, inverter or solar system?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Yes. The running watts are the continuous rating your inverter or UPS needs (plus a safety margin), the peak watts are its surge rating, and the daily units are what a solar system must produce. The next-step links below take your numbers to those calculators."
      }
     },
     {
      "@type": "Question",
      "name": "What is the electrical load estimation for a new house?",
      "acceptedAnswer": {
       "@type": "Answer",
       "text": "Add the rooms' lights and fans, one AC per bedroom you plan to cool, the kitchen appliances and the water pump, then apply a diversity factor because not everything runs together; the sanctioned-load calculator does this and recommends the kW to apply for."
      }
     }
