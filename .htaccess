# Hostinger deploys the whole repo (including .git) into this plugin folder.
# Block web access to repo internals; WordPress loads PHP files directly, not over HTTP.
# data/ holds source JSON with internal notes; pages never fetch it (numbers reach the browser through
# generated/ and the page HTML), so it is blocked too (audit WL-66).
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(\.git|\.github|specs|tests|tools|content|generated|data|node_modules)(/|$) - [F,L]
RewriteRule \.(md|csv|lock|yml|yaml|sh)$ - [F,L]
RewriteRule ^(package(-lock)?\.json|composer\.json)$ - [F,L]
</IfModule>
